{
    "name": "koishi-plugin-chatluna-unified-adapter",
    "description": "unified third-party API adapter for chatluna",
    "version": "0.1.0",
    "main": "lib/index.cjs",
    "module": "lib/index.mjs",
    "typings": "lib/index.d.ts",
    "files": [
        "lib",
        "dist"
    ],
    "exports": {
        ".": {
            "types": "./lib/index.d.ts",
            "import": "./lib/index.mjs",
            "require": "./lib/index.cjs"
        },
        "./package.json": "./package.json"
    },
    "type": "module",
    "author": "QJAG1024",
    "repository": {
        "type": "git",
        "url": "https://github.com/QJAG1024/chatluna-unified-adapter"
    },
    "license": "AGPL-3.0",
    "bugs": {
        "url": "https://github.com/QJAG1024/chatluna-unified-adapter/issues"
    },
    "homepage": "https://github.com/QJAG1024/chatluna-unified-adapter",
    "scripts": {
        "build": "atsc -b --force && node scripts/build.mjs",
        "build:dev": "atsc -b --force && node scripts/build.mjs --dev",
        "fetch-catalog": "node scripts/fetch-catalog.mjs",
        "probe": "tsx scripts/probe.ts",
        "typecheck": "tsc -b",
        "lint": "eslint src scripts --ext=ts,mjs",
        "lint-fix": "eslint src scripts --ext=ts,mjs --fix",
        "clean": "tsc -b --clean && rm -rf lib"
    },
    "engines": {
        "node": ">=18.0.0"
    },
    "dependencies": {
        "@chatluna/v1-shared-adapter": "^1.0.49",
        "@langchain/core": "^0.3.80",
        "zod": "3.25.76",
        "zod-to-json-schema": "^3.24.6"
    },
    "devDependencies": {
        "@types/node": "^22.18.7",
        "@typescript-eslint/eslint-plugin": "^7.18.0",
        "@typescript-eslint/parser": "^7.18.0",
        "atsc": "^2.1.0",
        "cordis": "^3.18.1",
        "eslint": "^8.57.1",
        "eslint-config-prettier": "^9.1.2",
        "eslint-config-standard": "^17.1.0",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-n": "^17.23.1",
        "eslint-plugin-prettier": "^5.5.4",
        "eslint-plugin-promise": "^7.2.1",
        "koishi": "^4.18.9",
        "koishi-plugin-chatluna": "^1.4.0-alpha.44",
        "prettier": "^3.6.2",
        "tsx": "^4.20.6",
        "typescript": "^5.9.2"
    },
    "peerDependencies": {
        "koishi": "^4.18.9",
        "koishi-plugin-chatluna": "^1.4.0-alpha.44"
    },
    "koishi": {
        "description": {
            "zh": "ChatLuna 第三方统一 API 适配器（单协议，端点与模型元数据可配）",
            "en": "Unified third-party API adapter for ChatLuna (one protocol per instance)"
        },
        "service": {
            "required": [
                "chatluna"
            ],
            "optional": [
                "chatluna_storage"
            ]
        }
    },
    "keywords": [
        "chatbot",
        "koishi",
        "plugin",
        "service",
        "chatluna",
        "adapter"
    ]
}
